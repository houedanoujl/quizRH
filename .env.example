# Lus au build (yarn generate / yarn borne:build), figés dans l'application.
# Code PIN de l'administration (5 tapes sur le logo), 4 à 8 chiffres.
# Obligatoire pour yarn borne:build ; seule son empreinte est embarquée (electron/admin-pin.json).
BORNE_ADMIN_PIN=
# Durée du quiz en secondes
NUXT_PUBLIC_QUIZ_DURATION=120
