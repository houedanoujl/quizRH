{
  "name": "ciprel-quiz-metier",
  "productName": "CIPREL Quiz Métier",
  "version": "1.0.0",
  "description": "Quiz métier CIPREL pour borne tactile hors ligne",
  "author": "CIPREL",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "borne:dev": "BORNE_DEV_URL=http://localhost:3000 electron .",
    "borne:preview": "nuxt generate && electron .",
    "borne:pin": "node scripts/borne-pin.mjs",
    "borne:build": "node scripts/borne-pin.mjs && nuxt generate && electron-builder --win nsis --x64",
    "borne:test": "node scripts/borne-pin.mjs && nuxt generate && electron-builder --win portable --x64",
    "export:client": "node scripts/export-client.mjs",
    "fusion": "node scripts/fusion-csv.mjs"
  },
  "devDependencies": {
    "@fontsource/baloo-2": "^5.2.5",
    "@fontsource/nunito": "^5.2.5",
    "@nuxtjs/tailwindcss": "^6.12.2",
    "@pinia/nuxt": "^0.7.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "nuxt": "^3.14.1592",
    "pinia": "^2.2.6",
    "qrcode": "^1.5.4",
    "sass": "^1.77.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "build": {
    "appId": "ci.ciprel.quizmetier",
    "productName": "CIPREL Quiz Métier",
    "directories": {
      "output": "dist-borne"
    },
    "files": [
      "electron/**",
      ".output/public/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/ios/512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "CIPREL-Quiz-Metier-${version}-test.exe"
    }
  }
}
